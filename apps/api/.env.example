# ─────────────────────────────────────────────────────────
#  ASTRAX-VOID API — Environment Variables
#  Copy to apps/api/.env and fill in every REQUIRED value.
#  Never commit apps/api/.env to git.
# ─────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# CORS — your frontend origin(s). Comma-separated list is supported.
# No trailing slash. Include every domain the browser will call the API from.
# e.g. https://astrax-void-web-upz5.vercel.app,https://astraxvoid.com,http://localhost:3000
CORS_ORIGIN=https://astrax-void-web-upz5.vercel.app,https://astraxvoid.com

# Public base URL of this API (used when building uploaded file URLs)
# No trailing slash. Example: http://34.201.64.198
PUBLIC_API_URL=http://34.201.64.198

# ── Database  [REQUIRED] ──────────────────────────────────
# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/astrax-void?retryWrites=true&w=majority"

# ── Redis  [REQUIRED if using sessions/queues] ────────────
# Upstash free tier: https://upstash.com
# Local: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ── JWT  [REQUIRED] ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── OAuth  [OPTIONAL — leave blank to disable] ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Payments  [OPTIONAL — leave blank to disable provider] ─
# Paystack (recommended for Nigeria / Africa)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE-xxxxxxxxxxxxxxxxxxxx

# Stripe (international)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── Cloudflare R2  [OPTIONAL — for digital file delivery] ──
# Create bucket + API token at https://dash.cloudflare.com/r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=astrax-void
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Email  [OPTIONAL — for order receipts / auth emails] ──
# Works with any SMTP provider (SendGrid, Mailgun, Postmark, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="ASTRAX-VOID <noreply@astraxvoid.com>"
