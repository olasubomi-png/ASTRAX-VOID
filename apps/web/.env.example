# ─────────────────────────────────────────────────────────
#  ASTRAX-VOID Web — Environment Variables
#  Copy to apps/web/.env.local and fill in values.
#  Run `npm run build` AFTER setting these — NEXT_PUBLIC_*
#  vars are embedded at build time, not runtime.
#  Never commit apps/web/.env.local to git.
# ─────────────────────────────────────────────────────────

# ── API connection  [REQUIRED] ────────────────────────────
# Points the browser at your Express API (via Nginx proxy).
# In production this is your domain — Nginx routes /api/* to port 4000.
NEXT_PUBLIC_API_URL=https://astraxvoid.com/api
NEXT_PUBLIC_APP_URL=https://astraxvoid.com

# ── NextAuth  [REQUIRED] ──────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_HEX_STRING
NEXTAUTH_URL=https://astraxvoid.com

# ── OAuth  [OPTIONAL — leave blank to disable] ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Payment public keys  [OPTIONAL] ──────────────────────
# These are safe to expose in the browser (public keys only).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
