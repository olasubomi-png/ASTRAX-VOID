# ─────────────────────────────────────────────────────────────────────────────
#  ASTRAX-VOID Web — Environment Variables Reference
#
#  THREE DEPLOYMENT MODES
#  ──────────────────────
#  1. Replit / local dev
#     Leave NEXT_PUBLIC_API_URL unset (or keep it blank).
#     The Next.js dev server rewrites /api-proxy/* → http://localhost:4000/api/*.
#     All API calls fall back to /api-proxy automatically.
#
#  2. EC2 + Nginx (same server — recommended)
#     Set NEXT_PUBLIC_API_URL=/api
#     Nginx on :80 routes /api/* → Express on :4000 (same origin).
#     No CORS, no proxy, no mixed-content issues.
#
#  3. Vercel (frontend only — API elsewhere)
#     Set NEXT_PUBLIC_API_URL=/api-proxy
#     vercel.json rewrites /api-proxy/* → your API origin.
#     For uploads > Vercel body limit: also set NEXT_PUBLIC_UPLOAD_URL.
#
#  IMPORTANT: NEXT_PUBLIC_* vars are embedded at BUILD TIME.
#  After changing them you MUST rebuild: pnpm --filter @astrax-void/web build
#  Then redeploy / restart the Next.js process.
# ─────────────────────────────────────────────────────────────────────────────

# ── API base URL  [REQUIRED] ─────────────────────────────────────────────────
# Mode 1 (Replit/dev):  leave blank — falls back to /api-proxy automatically
# Mode 2 (EC2/Nginx):   /api
# Mode 3 (Vercel):      /api-proxy
NEXT_PUBLIC_API_URL=/api

# ── App public URL  [REQUIRED — used for OG / meta tags] ─────────────────────
NEXT_PUBLIC_APP_URL=http://34.201.64.198

# ── Admin password login  [REQUIRED] ─────────────────────────────────────────
# Server-side only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Must match ADMIN_PASSWORD in apps/api/.env exactly.
ADMIN_PASSWORD=your_admin_password_here

# Signs the admin session cookie.  Must match SESSION_SECRET in apps/api/.env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# ── Social / contact links  [OPTIONAL] ───────────────────────────────────────
# Defaults are set in apps/web/lib/social-links.ts
# Override any of these to change the "Get Key" modal links.
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/1234567890
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/ASTRAXVOIDexe
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@astraxvoid
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/astraxvoid

# ── Large file uploads  [OPTIONAL — Vercel only] ─────────────────────────────
# EC2/Nginx: leave blank — uploads use /api/admin/upload (same origin).
# Vercel:    set to the direct HTTPS URL of the Express API, e.g.:
#            https://api.yourdomain.com/api
# This bypasses Vercel's ingress body-size cap for admin file uploads.
NEXT_PUBLIC_UPLOAD_URL=

# ── Next.js internal (server-side, not exposed to browser) ───────────────────
# Used by next.config.mjs rewrites (dev mode only).
# Points the Next.js server at the Express API for /api-proxy/* rewrites.
API_INTERNAL_URL=http://localhost:4000
