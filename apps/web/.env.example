# ─────────────────────────────────────────────────────────
#  ASTRAX-VOID Web — Environment Variables
#  Copy to apps/web/.env.local and fill in values.
#  Run `npm run build` AFTER setting these — NEXT_PUBLIC_*
#  vars are embedded at build time, not runtime.
#  Never commit apps/web/.env.local to git.
# ─────────────────────────────────────────────────────────

# ── API connection  [REQUIRED on Vercel] ──────────────────
# Points the browser at your Express API (via Nginx on AWS).
# This value is baked into the client bundle at build time.
# After changing it on Vercel you MUST redeploy.
# Prefer relative proxy (avoids mixed content + CORS from the browser).
# Vercel / Next rewrites /api-proxy/* → Express. Only use an absolute
# https:// URL if you have TLS on the API host.
NEXT_PUBLIC_API_URL=/api-proxy
NEXT_PUBLIC_APP_URL=https://astrax-void-web-upz5.vercel.app

# ── Admin password login  [REQUIRED on Vercel] ────────────
# Used by /api/admin-auth (server-side only — never prefix with NEXT_PUBLIC_).
# This is the password for the "Admin Password" tab on /admin/login.
ADMIN_PASSWORD=mickyp007

# Used to sign the local admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_HEX_STRING

# ── NextAuth  [OPTIONAL] ──────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_HEX_STRING
NEXTAUTH_URL=https://astrax-void-web-upz5.vercel.app

# ── OAuth  [OPTIONAL — leave blank to disable] ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Payment public keys  [OPTIONAL] ──────────────────────
# These are safe to expose in the browser (public keys only).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
